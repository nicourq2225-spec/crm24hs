datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  name          String
  initials      String
  role          String   @default("SELLER") // "ADMIN" | "SELLER"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  opportunities Opportunity[]
  alarmOpportunities AlarmOpportunity[]
  activityLogs  ActivityLog[]
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  phone         String
  type          String   @default("NO_DEFINIDO") // "PARTICULAR" | "NEGOCIO" | "NO_DEFINIDO"
  origin        String   // "Stand", "WhatsApp", "Instagram", "Referido", "Cliente anterior", "Otro"
  createdAt     DateTime @default(now())
  opportunities Opportunity[]
  alarmOpportunities AlarmOpportunity[]
}

model Opportunity {
  id               String   @id @default(uuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  
  // Fase 1: Embudos y Prioridades
  status           String   @default("NUEVO") // "NUEVO" | "CONTACTADO" | "NECESIDAD_IDENTIFICADA" | "PROPUESTA_ENVIADA" | "SEGUIMIENTO" | "GANADO" | "PERDIDO" | "NUTRICION" | "Papelera"
  priority         String   @default("MEDIA") // "ALTA" | "MEDIA" | "BAJA"
  urgency          String?  // "HOY" | "ESTA_SEMANA" | "ESTE_MES" | "MAS_ADELANTE" | "NO_SABE"
  nextAction       String?  // Ej: "Enviar propuesta", "Llamar"
  nextFollowUp     DateTime?
  lastContactDate  DateTime?
  
  // Fase 2: Calificación
  productInterest  String   // "Cámara", "Kit de cámaras", "Alarma", "Cerradura", "Videoportero", "Otro"
  needDescription  String?  // Qué quiere resolver
  qLocation        String?  // Casa, Negocio, Depósito, etc.
  qTargets         String[] // Entrada, Patio, etc.
  qHasCameras      String?  // Primer sistema, Ya tiene, etc.
  qZones           String?  // 1, 2, 3, 4, 5+, No definido
  qMobileAccess    String?  // Sí, No, No sabe
  qInstallRequired String?  // Solo equipo, Equipo + instalación, No sabe
  
  // Combos / Solución sugerida
  recommendedSolution String?
  proposalProducts    String?
  proposalBenefits    String?
  
  // Motivos de pérdida
  lossReason       String?  // "Precio", "Compró en otro lugar", etc.
  lossObservation  String?
  
  // Viejos campos económicos (los mantenemos por ahora)
  productModel     String?  
  budgetValue      Float?
  paymentMethod    String?  
  installments     Int?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  activityLogs     ActivityLog[]
}

model AlarmOpportunity {
  id                 String   @id @default(uuid())
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id])
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  
  status             String   @default("SIN_CALIFICAR") // "SIN_CALIFICAR" | "CONTACTADO" | "INTERESADO" | "PROPUESTA_ENVIADA" | "GANADO" | "PERDIDO"
  priority           String   @default("BAJA") // "ALTA" | "MEDIA" | "BAJA"
  
  hasAlarm           String?  // "Sí", "No", "Tenía", "No sabe"
  interestLevel      String?  // "Alto", "Medio", "Bajo", "No interesado", "Sin calificar"
  propertyType       String?  // "Casa", "Depto", "Negocio", "Depósito", "Oficina", "Otro"
  monitoringInterest String?  // "Interesado", "No interesado", "Quiere info", "Más adelante"
  
  nextAction         String?
  nextFollowUp       DateTime?
  lastContactDate    DateTime?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ActivityLog {
  id             String   @id @default(uuid())
  opportunityId  String
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  
  comment        String
  previousStatus String
  newStatus      String
  
  createdAt      DateTime @default(now())
}
